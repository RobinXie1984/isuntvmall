{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isuntvmall",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "account_id": "c805fea6fe0eb47cd90cd5e19f0ff00e",
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.isuntvmall.com",
    "BATCH_HELPER_ENABLED": "true"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.isuntvmall.com/*",
      "zone_id": "de861ddf7ba98795ff7f4e2e9b436edd"
    }
  ]
}
