# Public app URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase server credentials. Prefer the modern sb_secret_ key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback (use only if your project does not have secret keys yet):
# SUPABASE_SERVICE_ROLE_KEY=eyJ_REPLACE_ME

# Stripe test-mode keys for development.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Optional existing Stripe Shipping Rate, e.g. shr_...
STRIPE_SHIPPING_RATE_ID=
# Comma-separated ISO country codes accepted by Checkout.
STRIPE_ALLOWED_SHIPPING_COUNTRIES=HK,SG,MY,US,GB,AU,CA
STRIPE_AUTOMATIC_TAX=false

# Shared-password administration is retired. Never restore legacy passwords.

# Named staff identity. Not a browser secret; used server-side for Auth.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Enable only after migration, private buckets and named staff are provisioned.
BATCH_HELPER_ENABLED=false

# Checkout abuse protection (configure only in an approved staging/pilot).
# Public widget key; runtime-injected into the cart. No widget loads while checkout is closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Separate server-only random key, at least 32 characters. Never use a raw IP as the ledger key.
CHECKOUT_CLIENT_HASH_SECRET=
# The one existing scheduled worker may also sweep expired holds; off until verified.
COMMERCE_MAINTENANCE_ENABLED=false
