{
  "name": "isuntvmall",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test:reservations": "node scripts/verify-reservations.mjs",
    "test:backend": "node scripts/verify-staff.mjs && node scripts/verify-live-operations.mjs && node scripts/verify-order-operations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "@vinext/cloudflare": "1.0.0-beta.9",
    "next": "16.3.6",
    "papaparse": "5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "vinext": "1.0.0-beta.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.2.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.3"
  },
  "type": "module"
}
